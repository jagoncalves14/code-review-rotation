{
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.7.0",
	"scripts": {
		"build": "nuxi build",
		"dev": "nuxi dev",
		"preview": "nuxi preview",
		"generate": "nuxi generate",
		"postinstall": "nuxi prepare",
		"start": "node .output/server/index.mjs",
		"docker:up": "docker compose up --build",
		"start:generate": "npx serve .output/public",
		"lint": "eslint \"**/*.{vue,js,ts,tsx}\"",
		"lint:fix": "eslint \"**/*.{vue,js,ts,tsx}\" --fix",
		"stylelint": "stylelint \"**/*.{html,vue,css}\" --cache",
		"stylelint:fix": "stylelint \"**/*.{html,vue,css}\" --cache --fix",
		"prepare": "husky",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:report": "playwright show-report test/report",
		"typecheck": "vue-tsc --noEmit",
		"unit": "TZ=UTC vitest run",
		"unit:u": "TZ=UTC vitest run -u",
		"unit:watch": "TZ=UTC vitest watch"
	},
	"dependencies": {
		"@googleworkspace/cli": "^0.3.5",
		"@headlessui/vue": "^1.7.23",
		"@nordhealth/components": "^3.22.0",
		"@nordhealth/css": "^3.4.0",
		"@vueuse/core": "^13.9.0",
		"nuxt": "^3.21.11"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^4.19.0",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@iconify-json/carbon": "^1.2.28",
		"@iconify-json/twemoji": "^1.2.5",
		"@nuxt/test-utils": "^3.23.0",
		"@nuxtjs/color-mode": "^3.5.2",
		"@playwright/test": "^1.63.0",
		"@unocss/eslint-config": "^66.10.5",
		"@unocss/eslint-plugin": "^66.10.5",
		"@unocss/nuxt": "^66.10.5",
		"@unocss/postcss": "^66.10.5",
		"@unocss/preset-icons": "^66.10.5",
		"@unocss/preset-wind": "^66.10.5",
		"@unocss/transformer-directives": "^66.10.5",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vueform/multiselect": "2.6.11",
		"@vueuse/nuxt": "^13.9.0",
		"consola": "^3.4.2",
		"eslint": "^9.39.5",
		"eslint-plugin-format": "^1.5.0",
		"husky": "^9.1.7",
		"jsdom": "^26.1.0",
		"lint-staged": "^15.5.2",
		"postcss-html": "^1.8.1",
		"sass": "^1.105.1",
		"stylelint": "^16.26.1",
		"stylelint-config-recess-order": "^6.1.0",
		"stylelint-config-recommended-vue": "^1.6.1",
		"stylelint-config-standard-scss": "^14.0.0",
		"typescript": "^5.9.3",
		"unocss": "^66.10.5",
		"unplugin-auto-import": "^19.3.0",
		"vitest": "^4.1.11",
		"vue-tsc": "^2.2.12",
		"webpack": "^5.104.1",
		"zod": "^3.25.76"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix"
		],
		"*.vue": [
			"eslint --fix",
			"stylelint --fix"
		],
		"*.{html,sass,scss}": [
			"stylelint --fix"
		]
	},
	"config": {
		"commitizen": {
			"path": "node_modules/cz-git"
		}
	}
}
